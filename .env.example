# RepairPulse Environment Variables
# Copy to .env.local and fill in values

# LM Studio (Primary AI)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_DEFAULT_MODEL=nvidia/nemotron-3-nano-4b

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long

# Stripe Test Mode
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional External Providers
GEMINI_API_KEY=...
SARVAM_API_KEY=...
OMNIROUTE_BASE_URL=...
OMNIROUTE_API_KEY=...

# Hugging Face
HF_TOKEN=...
HF_DATASET_REPO=repairpulse/repair-duration
HF_MODEL_REPO=repairpulse/repair-duration-model

# Shodan (Admin only)
SHODAN_API_KEY=...

# Feature Flags
AI_LMSTUDIO_ENABLED=true
AI_GEMINI_ENABLED=false
AI_SARVAM_ENABLED=false
AI_OMNIROUTE_ENABLED=false
VISION_ENABLED=false
YOLO_ENABLED=false
PICKUP_ENABLED=true
PARTNER_PAYOUT_ENABLED=true
STRIPE_TEST_ENABLED=true
MCP_ENABLED=true
HARDWARE_ENABLED=false